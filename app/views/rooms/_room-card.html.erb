
<div class="my-8 border border-gray-50 md:flex-row w-full flex-col justify-between flex-wrap flex gap-5 items-center  rounded-md p-3 shadow-md">
            
          <div class="flex md:flex-row flex-col max-lg:items-start items-center gap-3">


              <%= image_tag room.image.attached? ? url_for(room.image) : "/images/noimage.jpg",
                alt: "Room image", 
                class: "rounded-md #{request.path.include?('/rooms/') ? 'w-[500px]' : 'md:w-[300px] md:h-[150px]'} object-cover" 
              %>

              <div class="flex flex-col mb-auto">
                <p class="font-bold text-2xl"> 
                  <%= room.name %>
                </p>

                  <% if request.path != '/rooms' && request.path != '/' && request.path != '/my_rooms' %>
                    <p><strong class="text-zinc-600">Description:</strong> <%= room.description %></p>
                  <% end %>
        

                <p><strong class="text-zinc-600">Availability:</strong> <%= room.availability %></p>
                <p><strong class="text-zinc-600">Address:</strong> <%= room.address %></p>
                <p class="font-semibold text-emerald-700"><strong class="text-zinc-600">Price:</strong> <%= room.price %></p>
              </div>


            </div>

          <div>
            
            <% if request.path == '/rooms' || request.path == '/' || request.path === '/my_rooms' %>

              <p>
                <%= link_to "View room", room, class: "ml-auto rounded-md px-3.5 py-2.5 bg-black text-white hover:bg-gray-50 inline-block font-medium" %>
              </p>

            <% end %>


          </div>
            
          </div>