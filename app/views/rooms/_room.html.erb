<div id="<%= dom_id room %>">
  <p class="my-5">
    <strong class="block font-medium mb-1">Name:</strong>
    <%= room.name %>
  </p>
  <p class="my-5">
    <strong class="block font-medium mb-1">Description:</strong>
    <%= room.description %>
  </p>
  <p class="my-5">
    <strong class="block font-medium mb-1">Availability:</strong>
    <%= room.availability %>
  </p>
  <p class="my-5">
    <strong class="block font-medium mb-1">Address:</strong>
    <%= room.address %>
  </p>
  <p class="my-5">
    <strong class="block font-medium mb-1">Price:</strong>
    <%= room.price %>
  </p>
  <p class="my-5">
    <strong class="block font-medium mb-1">Image:</strong>
    <%= room.image %>
  </p>
</div>
