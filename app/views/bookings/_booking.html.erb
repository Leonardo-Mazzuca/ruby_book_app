<div id="<%= dom_id booking %>">

  <p class="my-5">
    
        <%= render partial: 'rooms/room-card', locals: { room: booking.room } %>

  </p>


  <p class="text-emerald-800">
    <strong>Total price: </strong>
    <%= booking.room.price * booking.getHoursInterval %>
  </p>

<div class="grid grid-cols-2 gap-3">
  <p class="my-5 text-gray-600 font-normal text-md">
    <strong class="block font-bold mb-1 text-zinc-800">Check-in date:</strong>
    <%= booking.check_in.strftime('%d/%m/%Y') %>
  </p>
  <p class="my-5 text-gray-600 font-normal text-md">
    <strong class="block font-bold mb-1 text-zinc-800">Check-in time:</strong>
    <%= booking.check_in.strftime('%H:%M') %>
  </p>
  <p class="my-5 text-gray-600 font-normal text-md">
    <strong class="block font-bold mb-1 text-zinc-800">Check-out date:</strong>
    <%= booking.check_out.strftime('%d/%m/%Y') %>
  </p>
  <p class="my-5 text-gray-600 font-normal text-md">
    <strong class="block font-bold mb-1 text-zinc-800">Check-out time:</strong>
    <%= booking.check_out.strftime('%H:%M') %>
  </p>
</div>


</div>
