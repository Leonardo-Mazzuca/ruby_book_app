<% content_for :title, "Bookings" %>

<div class="w-full">

  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <div class="flex justify-between items-center">

    <h1 class="font-bold text-4xl">My bookings</h1>

  </div>

  <div id="bookings" class="min-w-full">
    <% if current_user && current_user.bookings.any? %>

      <% current_user.bookings.each do |booking| %>
        <div class="bg-gray-50 rounded-md p-3 border my-3 border-zinc-300 shadow-md">

            <%= render booking %>

            <p>
              <%= link_to "Show this booking", booking, class: "ml-2 rounded-md px-3.5 py-2.5 bg-zinc-900 text-white hover:bg-gray-50 inline-block font-medium" %>
            </p>

        </div>
      <% end %>
    <% else %>
      <p class="text-center my-10">You have no bookings.</p>
    <% end %>
  </div>
</div>
